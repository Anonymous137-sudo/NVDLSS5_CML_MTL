diff --git a/Sources/DLSSMLX/MLXNeuralStageTrace.swift b/Sources/DLSSMLX/MLXNeuralStageTrace.swift
new file mode 100644
--- /dev/null
+++ b/Sources/DLSSMLX/MLXNeuralStageTrace.swift
@@ -0,0 +1,104 @@
+import DLSSCore
+import Foundation
+import MLX
+
+/// Opt-in, bounded stage materialization for live captured-feature diagnostics.
+/// Disabled calls leave the ordinary lazy graph unchanged. Stage walls include
+/// forced synchronization and dump work; they are not acceptance FPS/GPU counters.
+final class MLXNeuralStageTrace: @unchecked Sendable {
+  @TaskLocal static var active: MLXNeuralStageTrace?
+  private static let lock = NSLock()
+  nonisolated(unsafe) private static var admitted = 0
+  nonisolated(unsafe) private static var seen = 0
+  private let directory: URL
+  private let label: String?
+  private let context: NeuralRenderFrameContext?
+  private var stages: [[String: Any]] = []
+  private var last = ProcessInfo.processInfo.systemUptime
+
+  static func begin(input: MLXArray, topology: String,
+                    context: NeuralRenderFrameContext?, label: String?) -> MLXNeuralStageTrace? {
+    let environment = ProcessInfo.processInfo.environment
+    guard let root = environment["DLSS_NR_STAGE_TRACE"], !root.isEmpty else { return nil }
+    let limit = min(8, max(1, Int(environment["DLSS_NR_STAGE_TRACE_FRAMES"] ?? "4") ?? 4))
+    let skip = max(0, Int(environment["DLSS_NR_STAGE_TRACE_SKIP"] ?? "6") ?? 6)
+    lock.lock()
+    seen += 1
+    guard seen > skip, admitted < limit else { lock.unlock(); return nil }
+    admitted += 1
+    let number = admitted
+    lock.unlock()
+    do {
+      let directory = URL(fileURLWithPath: root).appendingPathComponent("head-\(number)-\(UUID().uuidString)")
+      try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+      let trace = MLXNeuralStageTrace(directory: directory, label: label, context: context)
+      eval(input)
+      trace.record("feature-materialize", arrays: [input])
+      try JSONSerialization.data(withJSONObject: ["topology": topology, "inputShape": input.shape,
+        "label": label ?? "unlabelled", "scope": "Opt-in synchronized stages from live inference; not normal frame timing"])
+        .write(to: directory.appendingPathComponent("input.json"), options: .atomic)
+      return trace
+    } catch {
+      NSLog("NR stage trace creation failed: %@", String(describing: error))
+      return nil
+    }
+  }
+
+  private init(directory: URL, label: String?, context: NeuralRenderFrameContext?) {
+    self.directory = directory; self.label = label; self.context = context
+  }
+
+  func record(_ name: String, arrays: [MLXArray]) {
+    arrays.forEach { eval($0) }
+    let now = ProcessInfo.processInfo.systemUptime
+    stages.append(["name": name, "wallMS": (now-last)*1000, "shapes": arrays.map(\.shape)])
+    last = now
+  }
+
+  func dump(_ name: String, _ value: MLXArray, layout: String = "NHWC") {
+    do {
+      let packed = contiguous(value.asType(.float16))
+      eval(packed)
+      try packed.asData(access: .copy).data.write(to: directory.appendingPathComponent(name + ".f16"))
+      try JSONSerialization.data(withJSONObject: ["shape": packed.shape, "layout": layout, "dtype": "float16"])
+        .write(to: directory.appendingPathComponent(name + ".json"))
+    } catch { NSLog("NR stage dump failed: %@", String(describing: error)) }
+    // Explicit dump overhead is kept out of the next stage's wall time.
+    last = ProcessInfo.processInfo.systemUptime
+  }
+
+  func captureWindow(blockIndex: Int, input: MLXArray, output: MLXArray,
+                     origin: NeuralRenderingWindowOrigin, wallMS: Double) {
+    guard blockIndex == 1, input.shape.count == 4, input.shape[0] == 1,
+      input.shape[3] == 32, input.shape[1] >= 88, input.shape[2] >= 104 else { return }
+    var sources: [MLXArray] = [], results: [MLXArray] = [], locations: [[Int]] = []
+    for row in 0..<2 { for column in 0..<4 {
+      let y = 64 + origin.y + row * 8, x = 64 + origin.x + column * 8
+      sources.append(input[0..., y..<(y+8), x..<(x+8), 0...].reshaped([1,64,32]))
+      results.append(output[0..., y..<(y+8), x..<(x+8), 0...].reshaped([1,64,32]))
+      locations.append([y,x])
+    }}
+    let source = concatenated(sources, axis: 0).reshaped([1,8,64,32])
+    let result = concatenated(results, axis: 0).reshaped([1,8,64,32])
+    eval(source, result)
+    let beforeIO = ProcessInfo.processInfo.systemUptime, priorClock = last
+    dump("window1-input", source, layout: "NWTC")
+    dump("window1-output", result, layout: "NWTC")
+    do {
+      try JSONSerialization.data(withJSONObject: ["block": blockIndex, "sourceShape": input.shape,
+        "originsYX": locations, "windowOriginYX": [origin.y,origin.x], "publication": "E4M3", "fullBlockWallMS": wallMS])
+        .write(to: directory.appendingPathComponent("window1.json"))
+    } catch { NSLog("NR window trace metadata failed: %@", String(describing: error)) }
+    last = priorClock + ProcessInfo.processInfo.systemUptime - beforeIO
+  }
+
+  func finish() {
+    do {
+      var report: [String: Any] = ["stages": stages, "label": label ?? "unlabelled",
+        "scope": "Synchronized diagnostic stages; excludes final composition and presentation"]
+      if let context { report["streamID"] = context.streamID; report["frameIndex"] = context.frameIndex }
+      try JSONSerialization.data(withJSONObject: report, options: [.prettyPrinted, .sortedKeys])
+        .write(to: directory.appendingPathComponent("stages.json"), options: .atomic)
+    } catch { NSLog("NR stage report failed: %@", String(describing: error)) }
+  }
+}
