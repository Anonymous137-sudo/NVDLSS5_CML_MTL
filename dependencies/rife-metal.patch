+++ b/Sources/RifeMetalCore/Shaders/BackwardWarp.metal
@@ -162,14 +162,38 @@ kernel void rifeRGBToBGRA(
 ///
 /// out = w0 * sigmoid(mask) + w1 * (1 - sigmoid(mask))   then write as BGRA8 (alpha=1).
 ///
+// For the backward map x -> x + flow(x), a negative determinant reverses
+// local orientation. Taper the visibility adjustment before the map folds.
+static float rifeWarpConfidence(texture2d<half, access::read> flow, uint2 p) {
+    uint left = p.x == 0 ? 0 : p.x - 1;
+    uint right = min(p.x + 1, flow.get_width() - 1);
+    uint top = p.y == 0 ? 0 : p.y - 1;
+    uint bottom = min(p.y + 1, flow.get_height() - 1);
+    float2 dx = (float2(flow.read(uint2(right,p.y)).rg) -
+                 float2(flow.read(uint2(left,p.y)).rg)) / float(max(1u,right-left));
+    float2 dy = (float2(flow.read(uint2(p.x,bottom)).rg) -
+                 float2(flow.read(uint2(p.x,top)).rg)) / float(max(1u,bottom-top));
+    float det = (1.f + dx.x) * (1.f + dy.y) - dx.y * dy.x;
+    return isfinite(det) ? smoothstep(0.f, .25f, det) : 0.f;
+}
+
+static half rifeVisibility(half learned, texture2d<half, access::read> flowA,
+                           texture2d<half, access::read> flowB, uint2 p) {
+    float difference = rifeWarpConfidence(flowA,p) - rifeWarpConfidence(flowB,p);
+    // Equal confidence keeps the learned mask, including when both maps fold.
+    return half(mix(float(learned), difference >= 0.f ? 1.f : 0.f, abs(difference)));
+}
+
 /// Replaces the legacy (MPSGraph blend executable + rifeRGBToBGRA) pair with a single
-/// full-res pass. Math is identical (sigmoid + linear blend). At 4K this saves one full-res
+/// full-res pass. Applies geometric confidence to the learned visibility. At 4K this saves one full-res
 /// RGB read/write (~24 MB bandwidth) and one MPSGraph encode.
