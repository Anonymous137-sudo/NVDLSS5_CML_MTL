+    func testFastStreamAllMultipliersMatchIndependentPhases() throws {
+        let interp = try makeInterpolator(tier: .fast)
+        let fixtures = URL(fileURLWithPath: #filePath)
+            .deletingLastPathComponent().deletingLastPathComponent().appendingPathComponent("fixtures")
+        let a = try loadFixturePixelBuffer(fixtures.appendingPathComponent("frame_a.png"))
+        let b = try loadFixturePixelBuffer(fixtures.appendingPathComponent("frame_b.png"))
+        let stream = try interp.makeStream(width: CVPixelBufferGetWidth(a), height: CVPixelBufferGetHeight(a))
+
+        for factor in 2...6 {
+            let phases = (1..<factor).map { Float($0) / Float(factor) }
+            let expected = try interp.interpolate(previous: a, current: b, timesteps: phases)
+            stream.reset()
+            XCTAssertTrue(try stream.push(a, timesteps: []).isEmpty)
+            let actual = try stream.push(b, timesteps: phases)
+            XCTAssertEqual(actual.count, phases.count)
+            for (i, pair) in zip(actual, expected).enumerated() {
+                XCTAssertGreaterThan(PSNRHelper.compareInMemory(pair.0, pair.1), 50,
+                                     "factor \(factor), phase \(phases[i])")
+            }
+        }
+    }
+
