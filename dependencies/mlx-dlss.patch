@@ -0,0 +1,30 @@
+import Foundation
+import DLSSCore
+import MLX
+
+/// Device-resident full-frame model for a single owning capture worker.
+/// Same implementation and precision as MLXNeuralRenderer metal-fused.
+public final class MLXFullFrameRenderer {
+  private let model: NeuralRenderingTransformerModel
+  public let blockCount: Int
+  public let networkDescription: String
+  private let width: Int
+  private let height: Int
+  public init(packageURL: URL, networkWidth: Int = 1280, networkHeight: Int = 768) throws {
+    guard networkWidth >= 128, networkHeight >= 128,
+      networkWidth.isMultiple(of:64), networkHeight.isMultiple(of:64) else {
+      throw MLXBackendError.unsupportedSpatialShape(architecture:"mlxdlss.neural-rendering-transformer.v1",height:networkHeight,width:networkWidth,minimum:128,multiple:64)
+    }
+    width = networkWidth; height = networkHeight
+    let package = try ModelPackageLoader.load(url: packageURL)
+    let weights = try SafeTensorValidation.loadAndValidate(package: package).cast(to: .float16)
+    let topology = try NeuralRenderingTopology.infer(weights: weights)
+    blockCount = topology.blockCount
+    networkDescription = topology.description
+    model = try NeuralRenderingTransformerModel(weights: weights, compileBlocks: true, topology: topology)
+  }
+  public func callAsFunction(_ input: MLXArray) -> MLXArray {
+    precondition(input.shape == [1,height,width,16] && input.dtype == .float16)
+    return model(input)
+  }
+}
diff --git a/Sources/DLSSMLX/MLXGlobalBlockProbe.swift b/Sources/DLSSMLX/MLXGlobalBlockProbe.swift
new file mode 100644
--- /dev/null
+++ b/Sources/DLSSMLX/MLXGlobalBlockProbe.swift
@@ -0,0 +1,33 @@
+import MLX
+
+/// Explicit captured-stage diagnostics. No renderer call site selects this API.
+/// Uses the production gate, projected-attention and final residual kernels.
+public enum MLXGlobalBlockProbe {
+  public static func reference(
+    _ input: MLXArray, expansion: MLXArray, branch: MLXArray, ffnCosine: MLXArray,
+    qkv: MLXArray, scale: MLXArray, projection: MLXArray, attentionCosine: MLXArray
+  ) -> MLXArray {
+    precondition(NeuralRenderingGlobalBlock.experimentalLogitCap == 3)
+    return NeuralRenderingTransformerOperations.globalBlock(
+      input.reshaped([1, 20, 32, 1024]), expansionWeight: NeuralRenderingLinearWeight(expansion),
+      feedForwardProjectionWeight: NeuralRenderingLinearWeight(branch), feedForwardCosine: ffnCosine,
+      qkvWeight: qkv, attentionScale: scale, attentionBias: nil,
+      attentionProjectionWeight: projection, attentionCosine: attentionCosine,
+      headCount: 32, logitCap: 3, preciseSoftmax: true,
+      fusedOperations: true, publishOutput: true).reshaped([640, 1024])
+  }
+
+  public static func finish(
+    mid: MLXArray, qkv: MLXArray, scale: MLXArray,
+    projection: MLXArray, attentionCosine: MLXArray
+  ) -> MLXArray {
+    precondition(NeuralRenderingGlobalBlock.experimentalLogitCap == 3)
+    precondition(NeuralRenderingStreamedGlobalAttention.projectedEnabled(tokens: 640))
+    let attended = NeuralRenderingStreamedGlobalAttention.applyProjected(
+      qkv.reshaped([1, 640, 3072]), heads: 32, queryScale: scale * Float(32).squareRoot())
+    let branch = matmul(attended, projection)
+    return NeuralRenderingFusedWindowAttention.cosineResidual(
+      skip: mid.reshaped([1, 640, 1024]), branch: branch,
+      cosine: attentionCosine, publish: true).reshaped([640, 1024])
+  }
+}
diff --git a/Sources/DLSSMLX/MLXNeuralStageTrace.swift b/Sources/DLSSMLX/MLXNeuralStageTrace.swift
new file mode 100644
--- /dev/null
+++ b/Sources/DLSSMLX/MLXNeuralStageTrace.swift
@@ -0,0 +1,104 @@
+import DLSSCore
+import Foundation
+import MLX
+
+/// Opt-in, bounded stage materialization for live captured-feature diagnostics.
+/// Disabled calls leave the ordinary lazy graph unchanged. Stage walls include
+/// forced synchronization and dump work; they are not acceptance FPS/GPU counters.
+final class MLXNeuralStageTrace: @unchecked Sendable {
+  @TaskLocal static var active: MLXNeuralStageTrace?
+  private static let lock = NSLock()
+  nonisolated(unsafe) private static var admitted = 0
+  nonisolated(unsafe) private static var seen = 0
+  private let directory: URL
+  private let label: String?
+  private let context: NeuralRenderFrameContext?
+  private var stages: [[String: Any]] = []
+  private var last = ProcessInfo.processInfo.systemUptime
+
+  static func begin(input: MLXArray, topology: String,
+                    context: NeuralRenderFrameContext?, label: String?) -> MLXNeuralStageTrace? {
+    let environment = ProcessInfo.processInfo.environment
+    guard let root = environment["DLSS_NR_STAGE_TRACE"], !root.isEmpty else { return nil }
+    let limit = min(8, max(1, Int(environment["DLSS_NR_STAGE_TRACE_FRAMES"] ?? "4") ?? 4))
+    let skip = max(0, Int(environment["DLSS_NR_STAGE_TRACE_SKIP"] ?? "6") ?? 6)
+    lock.lock()
+    seen += 1
+    guard seen > skip, admitted < limit else { lock.unlock(); return nil }
+    admitted += 1
+    let number = admitted
+    lock.unlock()
+    do {
+      let directory = URL(fileURLWithPath: root).appendingPathComponent("head-\(number)-\(UUID().uuidString)")
+      try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+      let trace = MLXNeuralStageTrace(directory: directory, label: label, context: context)
+      eval(input)
+      trace.record("feature-materialize", arrays: [input])
+      try JSONSerialization.data(withJSONObject: ["topology": topology, "inputShape": input.shape,
+        "label": label ?? "unlabelled", "scope": "Opt-in synchronized stages from live inference; not normal frame timing"])
+        .write(to: directory.appendingPathComponent("input.json"), options: .atomic)
+      return trace
+    } catch {
+      NSLog("NR stage trace creation failed: %@", String(describing: error))
+      return nil
+    }
+  }
+
+  private init(directory: URL, label: String?, context: NeuralRenderFrameContext?) {
+    self.directory = directory; self.label = label; self.context = context
+  }
+
+  func record(_ name: String, arrays: [MLXArray]) {
+    arrays.forEach { eval($0) }
+    let now = ProcessInfo.processInfo.systemUptime
+    stages.append(["name": name, "wallMS": (now-last)*1000, "shapes": arrays.map(\.shape)])
+    last = now
+  }
+
+  func dump(_ name: String, _ value: MLXArray, layout: String = "NHWC") {
+    do {
+      let packed = contiguous(value.asType(.float16))
+      eval(packed)
+      try packed.asData(access: .copy).data.write(to: directory.appendingPathComponent(name + ".f16"))
+      try JSONSerialization.data(withJSONObject: ["shape": packed.shape, "layout": layout, "dtype": "float16"])
+        .write(to: directory.appendingPathComponent(name + ".json"))
+    } catch { NSLog("NR stage dump failed: %@", String(describing: error)) }
+    // Explicit dump overhead is kept out of the next stage's wall time.
+    last = ProcessInfo.processInfo.systemUptime
+  }
+
+  func captureWindow(blockIndex: Int, input: MLXArray, output: MLXArray,
+                     origin: NeuralRenderingWindowOrigin, wallMS: Double) {
+    guard blockIndex == 1, input.shape.count == 4, input.shape[0] == 1,
+      input.shape[3] == 32, input.shape[1] >= 88, input.shape[2] >= 104 else { return }
+    var sources: [MLXArray] = [], results: [MLXArray] = [], locations: [[Int]] = []
+    for row in 0..<2 { for column in 0..<4 {
+      let y = 64 + origin.y + row * 8, x = 64 + origin.x + column * 8
+      sources.append(input[0..., y..<(y+8), x..<(x+8), 0...].reshaped([1,64,32]))
+      results.append(output[0..., y..<(y+8), x..<(x+8), 0...].reshaped([1,64,32]))
+      locations.append([y,x])
+    }}
+    let source = concatenated(sources, axis: 0).reshaped([1,8,64,32])
+    let result = concatenated(results, axis: 0).reshaped([1,8,64,32])
+    eval(source, result)
+    let beforeIO = ProcessInfo.processInfo.systemUptime, priorClock = last
+    dump("window1-input", source, layout: "NWTC")
+    dump("window1-output", result, layout: "NWTC")
+    do {
+      try JSONSerialization.data(withJSONObject: ["block": blockIndex, "sourceShape": input.shape,
+        "originsYX": locations, "windowOriginYX": [origin.y,origin.x], "publication": "E4M3", "fullBlockWallMS": wallMS])
+        .write(to: directory.appendingPathComponent("window1.json"))
+    } catch { NSLog("NR window trace metadata failed: %@", String(describing: error)) }
+    last = priorClock + ProcessInfo.processInfo.systemUptime - beforeIO
+  }
+
+  func finish() {
+    do {
+      var report: [String: Any] = ["stages": stages, "label": label ?? "unlabelled",
+        "scope": "Synchronized diagnostic stages; excludes final composition and presentation"]
+      if let context { report["streamID"] = context.streamID; report["frameIndex"] = context.frameIndex }
+      try JSONSerialization.data(withJSONObject: report, options: [.prettyPrinted, .sortedKeys])
+        .write(to: directory.appendingPathComponent("stages.json"), options: .atomic)
+    } catch { NSLog("NR stage report failed: %@", String(describing: error)) }
+  }
+}
diff --git a/Sources/DLSSMLX/MLXStageSplit.swift b/Sources/DLSSMLX/MLXStageSplit.swift
new file mode 100644
--- /dev/null
+++ b/Sources/DLSSMLX/MLXStageSplit.swift
@@ -0,0 +1,76 @@
+import Foundation
+import DLSSCore
+import MLX
+
+/// Experimental, serial-worker API. The immutable context owns this frame's
+/// skips until both inference islands finish. Never reuse it for a later frame.
+public final class MLXStageSplitContext {
+  let encoded: NeuralRenderingEncoderOutput
+  public var centerInput: MLXArray { encoded.latent }
+  init(_ encoded: NeuralRenderingEncoderOutput) { self.encoded = encoded }
+}
+
+public final class MLXGlobalSplitContext {
+  let skip: MLXArray
+  public let input: MLXArray
+  init(skip: MLXArray, input: MLXArray) { self.skip = skip; self.input = input }
+}
+
+/// GPU blocks 0...22 and 48...70 surround an external blocks23...47 island.
+/// Same HT weights, padding, E4M3 publications and skip connections.
+public final class MLXStageSplit {
+  private let encoder: NeuralRenderingEncoder
+  private let splitEncoder: NeuralRenderingSplitEncoderStage
+  private let global: NeuralRenderingGlobalStage
+  private let bridge: NeuralRenderingDecoderInput
+  private let splitDecoder: [NeuralRenderingSplitWindowBlock]
+  private let decoder: NeuralRenderingDecoder
+  private let post: NeuralRenderingPostBlock
+
+  public init(packageURL: URL) throws {
+    let package = try ModelPackageLoader.load(url: packageURL)
+    let weights = try SafeTensorValidation.loadAndValidate(package: package).cast(to: .float16)
+    let topology = try NeuralRenderingTopology.infer(weights: weights)
+    guard topology == .ht else { throw MLXBackendError.unsupportedTopology("Stage split requires 71-block HT") }
+    encoder = try NeuralRenderingEncoder(weights: weights, compileBlocks: true, topology: topology)
+    splitEncoder = try NeuralRenderingSplitEncoderStage(weights: weights, fusedFeedForward: true, topology: topology)
+    global = try NeuralRenderingGlobalStage(weights: weights, fusedOperations: true, compileGraph: true, topology: topology)
+    bridge = try NeuralRenderingDecoderInput(weights: weights, topology: topology)
+    splitDecoder = try topology.splitDecoder.map {
+      try NeuralRenderingSplitWindowBlock(weights: weights, blockIndex: $0, preciseAttention: true, fusedFeedForward: true, topology: topology)
+    }
+    decoder = try NeuralRenderingDecoder(weights: weights, compileBlocks: true, topology: topology)
+    post = try NeuralRenderingPostBlock(weights: weights, compileBlocks: true, topology: topology)
+  }
+
+  public func begin(_ features: MLXArray) -> MLXStageSplitContext {
+    precondition(features.shape == [1,768,1280,16] && features.dtype == .float16)
+    let encoded = encoder(features)
+    eval(encoded.fullResolutionSkip, encoded.latent)
+    encoded.skips.forEach { eval($0) }
+    precondition(encoded.latent.shape == [1,24,40,512])
+    return MLXStageSplitContext(encoded)
+  }
+
+  public func referenceCenter(_ context: MLXStageSplitContext) -> MLXArray {
+    let split = beginGlobal(context)
+    return finishGlobal(split, latent: global(split.input))
+  }
+
+  public func beginGlobal(_ context: MLXStageSplitContext) -> MLXGlobalSplitContext {
+    let split = splitEncoder(context.centerInput)
+    eval(split.skip, split.latent)
+    return MLXGlobalSplitContext(skip: split.skip, input: split.latent)
+  }
+
+  public func finishGlobal(_ context: MLXGlobalSplitContext, latent: MLXArray) -> MLXArray {
+    let merged = bridge(latent, skip: context.skip)
+    return splitDecoder.reduce(merged) { value, block in block(value) }
+  }
+
+  public func finish(_ context: MLXStageSplitContext, center: MLXArray) -> MLXArray {
+    precondition(center.shape == [1,24,40,512] && center.dtype == .float16)
+    let decoded = decoder.afterSplit(center, skips: context.encoded.skips)
+    return post(decoded, skip: context.encoded.fullResolutionSkip)
+  }
+}
diff --git a/Sources/DLSSMLX/MLXVideoFrameIntensity.swift b/Sources/DLSSMLX/MLXVideoFrameIntensity.swift
new file mode 100644
--- /dev/null
+++ b/Sources/DLSSMLX/MLXVideoFrameIntensity.swift
@@ -0,0 +1,17 @@
+import Foundation
+import MLX
+
+extension MLXVideoFrame {
+  /// Apply the final display intensity after temporal history has been stored.
+  /// Cascaded model inputs and their histories retain their original values.
+  public func applyingIntensity(over source: MLXVideoFrame, strength: Float) throws -> MLXVideoFrame
+  {
+    guard width == source.width, height == source.height, strength.isFinite,
+      (0...2).contains(strength)
+    else {
+      throw MLXMediaError("Final NR intensity requires equal extents and strength 0...2")
+    }
+    if strength == 1 { return self }
+    return MLXVideoFrame(clip(source.array + (array - source.array) * strength, min: 0, max: 1))
+  }
+}
